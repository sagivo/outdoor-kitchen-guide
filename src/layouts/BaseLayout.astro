---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/bricolage-grotesque/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import displayLatin from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, OG_DEFAULT, NAV } from "../lib/site";
import { organizationLd } from "../lib/schema";
import { getModel } from "../data/models";
import { HOME_PICKS } from "../data/picks";
import { AFFILIATE_REL, amazonLink } from "../lib/amazon";
import PostHog from "../components/PostHog.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  article?: { pubDate: string; updatedDate?: string };
  /** hide the site-wide #1-pick promo bar (e.g. on pages already selling a product) */
  hidePromo?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  ogImage = OG_DEFAULT,
  jsonLd,
  noindex = false,
  article,
  hidePromo = false,
} = Astro.props;

const pageUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const fullTitle = title === SITE_NAME || title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ld = [organizationLd(), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const year = new Date().getFullYear();
const topPick = getModel(HOME_PICKS[0].id);
const [brandFirst, ...brandRest] = SITE_NAME.split(" ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#1a1512" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {article && <meta property="article:published_time" content={article.pubDate} />}
    {article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} guides`} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <PostHog />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {!hidePromo && (
      <div class="promo">
        <span class="promo-long">🔥 Our #1 built-in grill for 2026: </span><strong>{topPick.shortName}</strong> ·{" "}
        <a href={amazonLink(topPick.query, topPick.asin)} rel={AFFILIATE_REL} target="_blank">See today's price →</a>
      </div>
    )}
    <header class="site-header">
      <div class="wrap wide header-inner">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 32 32"><path d="M16 3c1 5-4 7-4 12a8 8 0 0 0 16 0c0-3-2-5-3-7-1 2-2 3-4 3 .5-3-2-6-5-8z" fill="currentColor"/></svg>
          </span>
          <span>{brandFirst} <b>{brandRest.join(" ")}</b></span>
        </a>
        <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
          <svg class="i-open" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          <svg class="i-close" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
        <nav id="primary-nav" aria-label="Primary">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
          <a class="nav-search" href="/search/" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2.4" fill="none"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
            <span class="nav-search-label">Search</span>
          </a>
          <a class="nav-cta" href="/tools/build-cost-estimator/">Price my build</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap wide">
        <div class="footer-cta">
          <div>
            <h2>Planning a build? Price it in 60 seconds.</h2>
            <p>Grill head, island, countertop, gas and extras — see the real total before you commit.</p>
          </div>
          <div class="cta-row">
            <a class="btn btn-lg" href="/tools/build-cost-estimator/">Price my build</a>
            <a class="btn secondary btn-lg" href="/posts/best-built-in-gas-grills-2026/">See the 2026 grill ranking</a>
          </div>
        </div>
        <div class="footer-grid">
          <div>
            <div class="footer-brand">
              <span class="brand-mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 32 32"><path d="M16 3c1 5-4 7-4 12a8 8 0 0 0 16 0c0-3-2-5-3-7-1 2-2 3-4 3 .5-3-2-6-5-8z" fill="currentColor"/></svg>
              </span>
              <span>{brandFirst} <b>{brandRest.join(" ")}</b></span>
            </div>
            <p class="footer-blurb">Independent guides to built-in gas grills and outdoor pizza ovens: comparisons, cost calculators, and real build math. We cross-check every spec against several sources.</p>
            <p class="footer-blurb"><a href="/how-we-research/">How we research →</a></p>
          </div>
          <div>
            <h2 class="footer-h">Best of 2026</h2>
            <ul>
              <li><a href="/posts/best-built-in-gas-grills-2026/">Best built-in gas grills</a></li>
              <li><a href="/posts/best-pizza-ovens-2026/">Best pizza ovens</a></li>
              <li><a href="/posts/napoleon-vs-blaze-vs-bull/">Napoleon vs Blaze vs Bull</a></li>
              <li><a href="/posts/ooni-vs-gozney/">Ooni vs Gozney</a></li>
              <li><a href="/posts/outdoor-kitchen-cost-breakdown/">Outdoor kitchen costs</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">Free tools</h2>
            <ul>
              <li><a href="/tools/build-cost-estimator/">Build cost estimator</a></li>
              <li><a href="/tools/grill-size-recommender/">Grill size recommender</a></li>
              <li><a href="/tools/pizza-oven-fuel-compare/">Pizza oven fuel compare</a></li>
              <li><a href="/grills/">Compare all models</a></li>
            </ul>
          </div>
          <div>
            <h2 class="footer-h">{SITE_NAME}</h2>
            <ul>
              <li><a href="/guides/">All guides</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/how-we-research/">How we research</a></li>
              <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
        </div>
        <p class="disclosure">
          As an Amazon Associate {SITE_NAME} earns from qualifying purchases (<a href="/affiliate-disclosure/">disclosure</a>).
          Product prices and availability are accurate as of the date/time indicated
          and are subject to change.
        </p>
        <p class="copy">© {year} {SITE_NAME}. All rights reserved.</p>
      </div>
    </footer>
    <div class="viz-tip" id="viz-tip" role="tooltip" hidden><strong></strong><span></span></div>
    <script>
      // Shared tooltip for chart marks: any element with data-tip-value / data-tip-label.
      const tip = document.getElementById("viz-tip")!;
      const show = (el: HTMLElement) => {
        tip.querySelector("strong")!.textContent = el.dataset.tipValue ?? "";
        tip.querySelector("span")!.textContent = el.dataset.tipLabel ?? "";
        tip.hidden = false;
        const r = el.getBoundingClientRect();
        const t = tip.getBoundingClientRect();
        const left = Math.min(Math.max(8, r.left + r.width / 2 - t.width / 2), window.innerWidth - t.width - 8);
        const top = r.top - t.height - 8 < 8 ? r.bottom + 8 : r.top - t.height - 8;
        tip.style.transform = `translate(${left}px, ${top}px)`;
      };
      const target = (e: Event) => (e.target as HTMLElement).closest?.<HTMLElement>("[data-tip-value]");
      document.addEventListener("pointerover", (e) => { const el = target(e); if (el) show(el); });
      document.addEventListener("focusin", (e) => { const el = target(e); if (el) show(el); });
      document.addEventListener("pointerout", (e) => { if (target(e)) tip.hidden = true; });
      document.addEventListener("focusout", (e) => { if (target(e)) tip.hidden = true; });
      window.addEventListener("scroll", () => (tip.hidden = true), { passive: true });

      const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
      const nav = document.getElementById("primary-nav");
      const header = document.querySelector<HTMLElement>(".site-header");
      btn?.addEventListener("click", () => {
        // The mobile menu is a full-screen sheet that starts below the header.
        if (header) document.documentElement.style.setProperty("--hdr", `${header.getBoundingClientRect().bottom}px`);
        const open = nav?.classList.toggle("open") ?? false;
        btn.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("nav-open", open);
      });
    </script>
  </body>
</html>
