---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const grills = MODELS.filter((m) => m.category === "grill");
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks.
const ACCENTS = ["#ff7a1a", "#e8631a", "#ffb35c", "#c96a1b"];

// Each project tile links to its guide; grill/oven tiles show their #1 pick.
const yardTypes = [
  { slug: "best-built-in-gas-grills-2026", icon: "🔥", title: "Built-in gas grills", text: "30–32 inch heads from Blaze, Napoleon, Bull, Coyote and Lion." },
  { slug: "best-pizza-ovens-2026", icon: "🍕", title: "Pizza ovens", text: "Ooni vs Gozney vs Solo Stove — gas vs wood, 12\" vs 16\"." },
  { slug: "outdoor-kitchen-cost-breakdown", icon: "💰", title: "Plan the budget", text: "What a real outdoor kitchen build costs, line by line." },
  { slug: "pizza-oven-fuel-guide", icon: "🪵", title: "Choose a fuel", text: "Gas vs wood vs electric for pizza ovens, honestly compared." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What is the best built-in gas grill in 2026?",
    a: `For most builders, the ${picks[0].model.name}: lifetime body warranty, 60,000 BTU, and heat zone separators. If you want rotisserie, the Napoleon Prestige 500 Built-In is the pick; for value, the Bull Outlaw 30.`,
  },
  {
    q: "What is the best outdoor pizza oven in 2026?",
    a: `The ${picks[2].model.name} for most buyers — 16-inch pizzas at 950°F with gas convenience. The Gozney Roccbox cooks the best 12-inch pizza, and the Ooni Karu 12 is the cheapest way into real wood-fired flavor.`,
  },
  {
    q: "How much does an outdoor kitchen cost?",
    a: "A basic grill island runs roughly $8,000–$15,000; a full kitchen with pizza oven and refrigeration runs $20,000–$40,000+. The grill head is usually only 30–50% of the total. Our build cost estimator prices your exact line items.",
  },
  {
    q: "Gas or wood pizza oven?",
    a: "Gas for convenience and consistency, wood for flavor ritual. In a 60-second Neapolitan bake the taste difference is subtle — most of the magic is the 950°F heat. Multi-fuel ovens let you start with one and switch later.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top built-in grills and pizza ovens of 2026", picks.map((p) => p.model)), faqLd(faq)];
---

<BaseLayout
  title={`${SITE_NAME}: Best Built-In Grills & Pizza Ovens of 2026, Compared`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>The best built-in grills &amp; pizza ovens of 2026, <em>ranked.</em></h1>
        <p class="lead">
          We compared {MODELS.length} built-in gas grills and pizza ovens on BTU,
          cooking area, max temperature, warranty and price — plus what the whole
          outdoor kitchen actually costs to build.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/best-built-in-gas-grills-2026/">See the grill ranking</a>
          <a class="btn secondary btn-lg" href="#match">Size my grill</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>products compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands tracked</span></div>
          <div><strong>3</strong><span>free build calculators</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>🏆 #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/grills/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{priceTier(top).label} price tier</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/grills/${top.id}/`}>Read the review →</a>
            <a href="/grills/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free sizing &amp; cost calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 products we'd buy in 2026</h2>
        <p class="section-sub">Two grill heads, two pizza ovens. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/posts/best-built-in-gas-grills-2026/">Full grill ranking →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <form class="matcher" id="match" action="/tools/grill-size-recommender/" method="get">
      <div>
        <span class="eyebrow" style="color:var(--ink)">30-second matcher</span>
        <h2>What size grill fits your cooking?</h2>
        <p>Two quick answers and we'll show the grill heads sized for your household and cooking style.</p>
      </div>
      <div class="mq">
        <fieldset>
          <legend>How many people do you cook for?</legend>
          <div class="mq-opts">
            <label><input type="radio" name="household" value="2" /><span>1–2</span></label>
            <label><input type="radio" name="household" value="4" checked /><span>3–4</span></label>
            <label><input type="radio" name="household" value="6" /><span>5–6</span></label>
            <label><input type="radio" name="household" value="9" /><span>7+</span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>What's your cooking style?</legend>
          <div class="mq-opts">
            <label><input type="radio" name="style" value="casual" checked /><span>Weeknight grilling</span></label>
            <label><input type="radio" name="style" value="steak" /><span>Steaks &amp; searing</span></label>
            <label><input type="radio" name="style" value="roast" /><span>Rotisserie &amp; roasts</span></label>
          </div>
        </fieldset>
        <button class="btn dark btn-lg" type="submit">Show my matches →</button>
      </div>
    </form>

    <div class="section-head">
      <div>
        <span class="eyebrow">Start your project</span>
        <h2 class="section-title">Grills, ovens &amp; budgets</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {yardTypes.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">See every pick</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Built-in grills at a glance</h2>
      </div>
      <a class="section-link" href="/grills/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={grills} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/build-cost-estimator/">
        <div class="tool-icon">💰</div>
        <h3>Outdoor Kitchen Cost Estimator</h3>
        <p>Price your full build: grill head, island, countertop, gas, electrical and extras.</p>
        <span class="go">Price my build</span>
      </a>
      <a class="tool-card" href="/tools/grill-size-recommender/">
        <div class="tool-icon">📐</div>
        <h3>Grill Size Recommender</h3>
        <p>Household size and cooking style → the BTUs and cooking area you need.</p>
        <span class="go">Size my grill</span>
      </a>
      <a class="tool-card" href="/tools/pizza-oven-fuel-compare/">
        <div class="tool-icon">🔥</div>
        <h3>Pizza Oven Fuel Compare</h3>
        <p>Gas vs wood vs electric: annual fuel cost, preheat time and 5-year totals.</p>
        <span class="go">Compare fuels</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which grill or oven we recommend.</p>
        <a class="btn" href="/how-we-research/">How we research</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>Real specs, cross-checked</h3><p>BTU, cooking area, and temperature claims verified across manufacturers, retailers and owner reports.</p></div>
        <div><div class="n">02</div><h3>No invented ratings</h3><p>We don't publish scores we can't defend. Picks come from specs, warranties, and documented owner experience.</p></div>
        <div><div class="n">03</div><h3>Tools, not just words</h3><p>Calculators built from real specs turn "what should I buy?" into a number, not a guess.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">Outdoor kitchen FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
